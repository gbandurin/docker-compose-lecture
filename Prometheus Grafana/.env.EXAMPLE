# ==POSTGRES for Grafana==
# Database provisioning
POSTGRES_DB: ${GF_POSTGRES_DB:-grafana}
POSTGRES_USER: ${GF_POSTGRES_USER:-grafana}
POSTGRES_PASSWORD: ""

# ==GRAFANA==
# Grafana's connect Configuration
GF_DATABASE_TYPE: postgres
GF_DATABASE_HOST: postgres:5432
GF_DATABASE_NAME: ${POSTGRES_DB:-grafana}
GF_DATABASE_USER: ${POSTGRES_USER:-grafana}
GF_DATABASE_PASSWORD: ${POSTGRES_PASSWORD}
GF_DATABASE_SSL_MODE: disable

# Server Configuration
GF_SERVER_DOMAIN: server.com
GF_SERVER_ROOT_URL: https://server.com
GF_SERVER_SERVE_FROM_SUB_PATH: "true"
GF_SERVER_ENFORCE_DOMAIN: "true"

# Security
GF_SECURITY_ADMIN_USER: ${GF_ADMIN_USER:-admin}
GF_SECURITY_ADMIN_PASSWORD: ""
GF_SECURITY_SECRET_KEY: ""
GF_SECURITY_DISABLE_GRAVATAR: "true"
GF_SECURITY_COOKIE_SECURE: "true"
GF_SECURITY_COOKIE_SAMESITE: strict
GF_SECURITY_STRICT_TRANSPORT_SECURITY: "true"
GF_SECURITY_STRICT_TRANSPORT_SECURITY_MAX_AGE_SECONDS: 31536000
GF_SECURITY_STRICT_TRANSPORT_SECURITY_PRELOAD: "true"

# Disable Anonymous Access
GF_AUTH_ANONYMOUS_ENABLED: "false"

# Session Configuration
GF_SESSION_PROVIDER: postgres
GF_SESSION_PROVIDER_CONFIG: "user=${POSTGRES_USER:-grafana} password=${POSTGRES_PASSWORD} host=postgres port=5432 dbname=${POSTGRES_DB:-grafana} sslmode=disable"

# Logging
GF_LOG_MODE: console
GF_LOG_LEVEL: info

# Performance
GF_DATABASE_MAX_OPEN_CONN: 300
GF_DATABASE_MAX_IDLE_CONN: 100
GF_DATAPROXY_TIMEOUT: 300
GF_DATAPROXY_DIAL_TIMEOUT: 30
GF_DATAPROXY_KEEP_ALIVE_SECONDS: 300

# Users
GF_USERS_ALLOW_SIGN_UP: "false"
GF_USERS_ALLOW_ORG_CREATE: "false"

# Alerting
GF_ALERTING_ENABLED: "true"
GF_UNIFIED_ALERTING_ENABLED: "true"

